<?xml version="1.0" encoding="UTF-8"?>
<xed:form
  xmlns:xed="http://www.mycore.de/xeditor"
  role="form"
  class="form-horizontal ir-editor-form profkat-editor-metadata"
  accept-charset="UTF-8" method="post">
  <div class="form-group row">
    <label class="alert alert-info w-100 ir-editor-alert">
      <xed:output i18n="Editor.Common.headline" />
    </label>
  </div>
  <xed:include uri="resource:editor/metadata/includes-generic.xed" ref="cleanup-rules" />
  <xed:include uri="resource:editor/metadata/includes-generic.xed" ref="in.out" />
  <xed:bind xpath="/mycoreobject">
    <xed:bind xpath="@ID" initially="{$MCR.SWF.Project.ID}_matrikel_00000000" />
    <xed:bind xpath="@label" initially="person" />
    <xed:bind xpath="@xsi:noNamespaceSchemaLocation" initially="datamodel-matrikel.xsd" />
    <xed:bind xpath="metadata">
      <xed:include uri="resource:editor/metadata/includes-generic.xed" ref="failed-validation-messages" />
      <xed:include uri="resource:editor/metadata/includes-person.xed" ref="state" />
      <xed:include uri="resource:editor/metadata/cug-includes-matrikel.xed" ref="semester" />
      <xed:include uri="resource:editor/metadata/cug-includes-matrikel.xed" ref="enrollment-date" />
      <xed:include uri="resource:editor/metadata/cug-includes-matrikel.xed" ref="enrollment-number" />
      <xed:include uri="resource:editor/metadata/cug-includes-matrikel.xed" ref="enrollment-sequence-number" />
      <xed:include uri="resource:editor/metadata/cug-includes-matrikel.xed" ref="name" />
      <xed:include uri="resource:editor/metadata/cug-includes-matrikel.xed" ref="origin" />
      <xed:include uri="resource:editor/metadata/cug-includes-matrikel.xed" ref="fields-of-study" />
      <xed:include uri="resource:editor/metadata/cug-includes-matrikel.xed" ref="prior-enrollments" />
      <xed:include uri="resource:editor/metadata/cug-includes-matrikel.xed" ref="prior-matriculation" />
      <xed:include uri="resource:editor/metadata/cug-includes-matrikel.xed" ref="fee" />
      <xed:include uri="resource:editor/metadata/cug-includes-matrikel.xed" ref="occupation" />
      <xed:include uri="resource:editor/metadata/cug-includes-matrikel.xed" ref="guardian" />
      <xed:include uri="resource:editor/metadata/cug-includes-matrikel.xed" ref="school-certificate" />
      <xed:include uri="resource:editor/metadata/includes-person.xed" ref="other-infos" />
      <xed:include uri="resource:editor/metadata/cug-includes-matrikel.xed" ref="source" />
      <script type="module" src="{$WebApplicationBaseURL}js/cug/category-picker.js"></script>
      <script type="module" src="{$WebApplicationBaseURL}js/cug/reference-picker.js"></script>
    </xed:bind>
    <xed:include uri="resource:editor/metadata/includes-generic.xed" ref="cancel.submit" />
    <xed:include uri="resource:editor/metadata/includes-generic.xed" ref="validation-rules" />
  </xed:bind>
</xed:form>
