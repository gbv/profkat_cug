<?xml version="1.0" encoding="UTF-8"?>
<xed:form
  role="form"
  class="form-horizontal ir-editor-form profkat-editor-metadata"
  accept-charset="UTF-8"
  method="post"
  xmlns:xed="http://www.mycore.de/xeditor">

  <xed:post-processor xsl="editor-person-postprocessor.xsl" />

  <xed:cleanup-rule xpath="//*" relevant-if="true()" />
  <xed:cleanup-rule xpath="//*[@class='MCRMetaHistoryEvent']/*/text" relevant-if="string-length(text()) &gt; 0" />
  <xed:cleanup-rule xpath="/mycoreobject/metadata//*" relevant-if="@* or * or (string-length(text()) &gt; 0)" />
  <xed:cleanup-rule xpath="//*[@class='MCRMetaXML']/*" relevant-if=".//*[@* or (string-length(text()) &gt; 0)]" />
  <xed:cleanup-rule xpath="//*[@class='MCRMetaLangText']/*" relevant-if="string-length(text()) &gt; 0" />
  <xed:cleanup-rule xpath="//*[@class='MCRMetaLink']/*" relevant-if="string-length(@xlink:href) &gt; 0" />
  <xed:cleanup-rule xpath="/mycoreobject/metadata/*" relevant-if="./*" />

  <xed:include uri="resource:editor/metadata/includes-generic.xed" ref="in.out" />

  <xed:bind xpath="/mycoreobject">
    <xed:include uri="resource:editor/metadata/includes-generic.xed" ref="mycore.common" />
    <xed:bind xpath="metadata">
      <xed:include uri="resource:editor/metadata/includes-generic.xed" ref="failed-validation-messages" />
      <div class="form-group row">
        <label class="alert alert-info w-100 ir-editor-alert">
          <xed:output i18n="Editor.Common.headline" />
        </label>
      </div>
      <xed:choose>
        <xed:when test="starts-with(/mycoreobject/@ID,'cug_matrikel')">
          <xed:include ref="matrikel" />
        </xed:when>
        <xed:otherwise>
          <xed:include ref="person" />
        </xed:otherwise>
      </xed:choose>
    </xed:bind>
    <xed:include uri="resource:editor/metadata/includes-generic.xed" ref="cancel.submit" />
  </xed:bind>

  <xed:template id="matrikel">
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="state" />
    <xed:include uri="resource:editor/metadata/cug-matrikel-includes.xed" ref="semester" />
    <xed:include uri="resource:editor/metadata/cug-matrikel-includes.xed" ref="enrollment-date" />
    <xed:include uri="resource:editor/metadata/cug-matrikel-includes.xed" ref="enrollment-number" />
    <xed:include uri="resource:editor/metadata/cug-matrikel-includes.xed" ref="enrollment-sequence-number" />
    <xed:include uri="resource:editor/metadata/cug-matrikel-includes.xed" ref="name" />
    <xed:include uri="resource:editor/metadata/cug-matrikel-includes.xed" ref="origin" />
    <xed:include uri="resource:editor/metadata/cug-matrikel-includes.xed" ref="field-of-study" />
    <xed:include uri="resource:editor/metadata/cug-matrikel-includes.xed" ref="prior-enrollments" />
    <xed:include uri="resource:editor/metadata/cug-matrikel-includes.xed" ref="prior-matriculation" />
    <xed:include uri="resource:editor/metadata/cug-matrikel-includes.xed" ref="fee" />
    <xed:include uri="resource:editor/metadata/cug-matrikel-includes.xed" ref="occupation" />
    <xed:include uri="resource:editor/metadata/cug-matrikel-includes.xed" ref="guardian" />
    <xed:include uri="resource:editor/metadata/cug-matrikel-includes.xed" ref="school-certificate" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="other-infos" />
    <xed:include uri="resource:editor/metadata/cug-matrikel-includes.xed" ref="source" />

    <xed:cleanup-rule xpath="//*[@class='MCRMetaXML']/*" relevant-if="./*" />
  </xed:template>

  <xed:template id="person">
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="state" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="person-type" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="epochs" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="name-group" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="professorships" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="periods" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="faculties" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="institutes" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="fields-of-study" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="subjects" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="departures" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="email" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="homepages" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="birth" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="death" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="gender" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="confession" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="family-members" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="biographic-entries" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="academic-degrees" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="admin-functions" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="other-functions" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="memberships" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="party-memberships" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="awards" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="main-publications" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="publication-links" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="sources" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="references" />
    <xed:if test="not(starts-with(//mycoreobject/@ID,'cpb_'))">
      <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="complex-references" />
    </xed:if>
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="identifiers" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="other-infos" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="internal-infos" />
    <xed:include uri="resource:editor/metadata/person-editor-includes.xed" ref="gnd-check" />
  </xed:template>

</xed:form>
