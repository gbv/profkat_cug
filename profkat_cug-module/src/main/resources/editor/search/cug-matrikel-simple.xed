<?xml version="1.0" encoding="UTF-8"?>
<xed:form
  xmlns:xed="http://www.mycore.de/xeditor"
  role="form"
  class="form-horizontal"
  accept-charset="UTF-8" method="post">
	<input
	  type="submit"
	  xed:target="servlet"
	  xed:href="/do/search/cug-matrikel-simple"
	  style="position:absolute; left:-4000px; top:1px;" />
	<xed:bind xpath="query">
    <xed:bind xpath="@mask" default="cug-matrikel-simple" />
    <xed:bind xpath="sortBy/field[@name='cug.matrikel.name.plain']/@order" default="ascending" />
    <xed:cleanup-rule xpath="//*[starts-with(name(), 'condition')]" relevant-if="* or (string-length(@value) &gt; 0)" />
    <xed:cleanup-rule xpath="//boolean" relevant-if="*" />
    <xed:bind xpath="conditions[@format='xml']/boolean[@operator='and']">
      <xed:bind xpath="condition[@field='objectType'][@operator='=']/@value" default="matrikel" />
      <xed:bind xpath="condition[@field='allMeta'][@operator='like']/@value" default="*" />
      <div class="card">
        <div class="card-body">
          <xed:include uri="resource:editor/search/cug-matrikel-includes.xed" ref="name" />
        </div>
        <div class="card-body">
          <xed:include uri="resource:editor/search/includes-search-profkat.xed" ref="searchfield.allMeta" />
        </div>
        <div class="card-footer">
          <div class="row">
            <div class="offset-3 col-9">
              <button
                type="submit"
                xed:target="servlet"
                xed:href="/do/search/cug-matrikel-simple"
                class="btn btn-primary">
                <xed:output i18n="Editor.Search.search" />
              </button>
              <xed:if test="
                xed:call-java('org.mycore.common.xml.MCRXMLFunctions','isCurrentUserInRole','wf_edit_profkat-matrikel')
              ">
                <button type="submit" class="btn btn-default" xed:target="debug">
                  <xed:output i18n="Editor.Common.button.debug" />
                </button>
              </xed:if>
            </div>
          </div>
        </div>
      </div>
    </xed:bind>
  </xed:bind>
</xed:form>
