<fmt:message var="gotoContents" key="Webpage.gotoContents" />
<div class="sr-only">
  <h1>${pageTitle}</h1>
  <p>
    <a href="#contents" title="${gotoContents}">${gotoContents}</a>
  </p>
</div>
<div class="container-fluid ir-nav-top">
  <div class="container d-flex flex-row-reverse justify-content-between">
    <div class="navbar navbar-expand-lg">
      <mcr:outputNavigation id="top" mode="top" cssClass="nav navbar-nav pull-right">
        <mcr:session var="username" info="userID" />
        <c:if test="${not (username eq 'guest')}">
          <li class="nav-item userinfo">
            <a href="${WebApplicationBaseURL}do/workspace/tasks" class="nav-link">
              <fmt:message key="WF.workspace" />
            </a>
          </li>
          <li id="topnav_login" class="nav-item userinfo">
            <span class="nav-link">
              <fmt:message key="Webpage.login.User" />:
              &#160;
              <span class="username">
                ${username}
              </span>
            </span>
          </li>
          <li id="topnav_logout" class="nav-item">
            <a class="nav-link" href="${WebApplicationBaseURL}do/login?logout=true&returnTo=${WebApplicationBaseURL}">
              <span class="action">
                <fmt:message key="Nav.Logout" />
              </span>
            </a>
          </li>
        </c:if>
        <c:if test="${username eq 'guest'}">
          <li id="topnav_login" class="nav-item">
            <a
              href="${WebApplicationBaseURL}servlets/MCRShibbolethLoginServlet?url=${WebApplicationBaseURL}"
              class="btn btn-primary btn-sm mt-1 mb-1"
              role="button">
              <fmt:message key="Nav.Login" />
            </a>
          </li>
        </c:if>
      </mcr:outputNavigation>
    </div>
  </div>
</div>
<div class="ir-header" style="position: relative;">
  <div class="container d-none d-md-block mb-3">
    <div class="row">
      <div class="col ir-logo mt-4">
        <img
          style="width: 150px;float: left;"
          src="${WebApplicationBaseURL}images/logo_georg_august_univeritaet.png" />
        <h1>Catalogus Universitatis Gottingensis</h1>
      </div>
    </div>
  </div>
</div>
<div class="container ir-nav-main">
  <nav class="navbar navbar-expand-md p-0">
    <button
      class="navbar-toggler ir-nav-toggler"
      type="button"
      data-toggle="collapse"
      data-target="#irNavContent"
      aria-controls="irNavContent"
      aria-expanded="false"
      aria-label="Toggle navigation">
      <i class="fas fa-bars"></i>
    </button>
    <div class="collapse navbar-collapse" id="irNavContent">
      <ul class="nav nav-pills nav-justified level-0 w-100">
        <li class="nav-item">
          <a class="nav-link" href="${WebApplicationBaseURL}">
            <fmt:message key="Nav.Start" />
          </a>
        </li>
        <li class="nav-item dropdown">
          <a
            class="nav-link dropdown-toggle"
            href="#"
            id="stuffDropdown"
            role="button"
            data-toggle="dropdown"
            aria-expanded="false">
            <fmt:message key="cug.nav.stuff" />
          </a>
          <div class="dropdown-menu" aria-labelledby="stuffDropdown">
            <a class="dropdown-item" href="${WebApplicationBaseURL}do/indexbrowser/profname">
              <fmt:message key="Nav.Profkat.Index" />
            </a>
            <a class="dropdown-item" href="${WebApplicationBaseURL}do/search/profkat-bar">
              <fmt:message key="Nav.Profkat.Search" />
            </a>
          </div>
        </li>
        <li class="nav-item dropdown">
          <a
            class="nav-link dropdown-toggle"
            href="#"
            id="studentDropdown"
            role="button"
            data-toggle="dropdown"
            aria-expanded="false">
            <fmt:message key="cug.nav.students" />
          </a>
          <div class="dropdown-menu" aria-labelledby="studentDropdown">
            <a class="dropdown-item" href="${WebApplicationBaseURL}do/indexbrowser/matname">
              <fmt:message key="Nav.Profkat.Index" />
            </a>
            <a class="dropdown-item" href="${WebApplicationBaseURL}do/search/cug-matrikel-bar">
              <fmt:message key="Nav.Profkat.Search" />
            </a>
          </div>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="${WebApplicationBaseURL}site/ueber_uns?info=info.kontakt">
            <fmt:message key="Nav.Profkat.AboutUs" />
          </a>
        </li>
      </ul>
    </div>
  </nav>
  <div class="row d-none d-md-block">
    <div class="col-12 ir-divider">
      <hr />
    </div>
  </div>
</div>
